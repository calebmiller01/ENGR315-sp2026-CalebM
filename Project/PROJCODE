def project_question_two(data):
    """
    Question:
    How does the size of a moving average window affect the visibility and interpretation
    of COVID-19 outbreak waves?

    This function compares raw daily case data to several moving averages:
    - 3-day moving average
    - 7-day moving average
    - 14-day moving average
    - 30-day moving average

    It calculates:
    - standard deviation for each smoothed dataset
    - number of detected peaks for each smoothed dataset
    """

    ##store Harrisonburg data
    harrislist = []
    harrisdaily = []
    dates = []

    ##go through every row in data and store Harrisonburg entries
    for i in data:
        if i[1] == 'Harrisonburg city' and i[2] == 'Virginia':
            harrislist.append(i)

    ##calculate daily new cases from case totals
    for i in range(1, len(harrislist)):
        dailycases = harrislist[i][4] - harrislist[i - 1][4]

        ##prevents weird negative values from dataset
        if dailycases < 0:
            dailycases = 0

        harrisdaily.append(dailycases)
        dates.append(harrislist[i][0])

    ##moving avge window sizes to compare
    windows = [3, 7, 14, 30]

    moving_average_lists = []
    standard_deviations = []
    peak_counts = []

    print("Question 2: Moving Average Window Comparison")
    print()

    ##calculate raw std
    rawmean = sum(harrisdaily) / len(harrisdaily)

    rawvariance = 0
    for i in harrisdaily:
        rawvariance = rawvariance + (i - rawmean) ** 2

    rawvariance = rawvariance / len(harrisdaily)
    rawstd = rawvariance ** 0.5

    print("Raw Daily Cases")
    print("Standard deviation:", rawstd)
    print()

    ## calculate moving averages for each window size
    for window in windows:

        movingavg = []

        for i in range(len(harrisdaily)):

            ## only calculate average once enough previous days exist
            if i < window - 1:
                movingavg.append(0)
            else:
                s = sum(harrisdaily[i - window + 1:i + 1])
                avg = s / window
                movingavg.append(avg)

        moving_average_lists.append(movingavg)

        ## calculate standard deviation of moving average
        avgmean = sum(movingavg) / len(movingavg)

        variance = 0
        for i in movingavg:
            variance = variance + (i - avgmean) ** 2

        variance = variance / len(movingavg)
        std = variance ** 0.5

        standard_deviations.append(std)

        ##count peaks
        ##a peak is counted when the value is greater than the point before and after
        ##and also greater than 20 cases to avoid counting irrelebant bumps
        peaks = 0

        for i in range(1, len(movingavg) - 1):
            if movingavg[i] > movingavg[i - 1] and movingavg[i] > movingavg[i + 1] and movingavg[i] > 20:
                peaks = peaks + 1

        peak_counts.append(peaks)

        print(str(window) + "-Day Moving Average")
        print("Standard deviation:", std)
        print("Number of detected peaks:", peaks)
        print()

    ##graph 1 raw cases and moving averages over time
    ##create plot and labels
    plt.figure(figsize=(10, 6))

    xvalues = list(range(len(dates)))

    plt.plot(xvalues, harrisdaily, label="Raw Daily Cases")

    for i in range(len(windows)):
        plt.plot(xvalues, moving_average_lists[i], label=str(windows[i]) + "-Day Average")

    ##arange labels for visibiltiy
    ticklocations = []
    ticklabels = []

    for i in range(0, len(dates), 120):
        ticklocations.append(i)
        ticklabels.append(dates[i])

    plt.xticks(ticklocations, ticklabels, rotation=45)

    plt.title("Effect of Moving Average Window Size on COVID-19 Case Trends")
    plt.xlabel("Date")
    plt.ylabel("Daily New Cases")
    plt.legend()
    plt.tight_layout()
    plt.savefig("question2_moving_average_comparison.png")
    plt.show()

    ##graph 2 number of detected peaks by raw data and moving average windows
    rawpeaks = 0
    ## count peaks and stop before last val to have before and agyer vals

    for i in range(1, len(harrisdaily) - 1):
        ##check peak criteria
        if harrisdaily[i] > harrisdaily[i - 1] and harrisdaily[i] > harrisdaily[i + 1] and harrisdaily[i] > 20:
            rawpeaks = rawpeaks + 1
##avg windows for axis
    peak_xvalues = [1, 3, 7, 14, 30]
    peak_labels = ["Raw", "3-Day", "7-Day", "14-Day", "30-Day"]
    peak_values = [rawpeaks] + peak_counts

    ##create new fig for peaks vs win size
    plt.figure(figsize=(8, 6))

    plt.plot(peak_xvalues, peak_values, marker='o')

    ##add labels above pts
    for i in range(len(peak_xvalues)):
        label = str(peak_values[i]) + " peaks"
        ##add special label so raw labels dont overlap lines
        if peak_labels[i] == "Raw":
            plt.text(peak_xvalues[i] + 0.6, peak_values[i] + 2, label, ha='left')
        else:
            plt.text(peak_xvalues[i], peak_values[i] + 2, label, ha='center')

    ##fig titles
    plt.title("Detected Peaks vs. Moving Average Window Size")
    plt.xlabel("Moving Average Window Size (Days)")
    plt.ylabel("Number of Detected Peaks")
    plt.xticks(peak_xvalues, peak_labels)
